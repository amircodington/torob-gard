# Copy to .env.prod on the server (never commit it). Names only; docs/DEPLOY.md explains each.
# --- compose / nginx ---
SERVER_NAME=
SITE_URL=
# TLS_CERT=/etc/letsencrypt/live/<SERVER_NAME>/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/<SERVER_NAME>/privkey.pem
# CERTS_DIR=/etc/letsencrypt
# HTTP_PORT=80
# HTTPS_PORT=443
# BUILD_ID=
NEXT_PUBLIC_IMG_BASE=/img
# --- database (hex only: it goes into DATABASE_URL) ---
POSTGRES_PASSWORD=
# --- api + agent ---
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=<SERVER_NAME>,api
PHONE_PEPPER=
PHONE_KEY=
KAVENEGAR_KEY=
KAVENEGAR_TEMPLATE=
BOXAPI_KEY=
BOXAPI_KEY_SECOND=
BOXAPI_BASE_URL=https://api.gapgpt.app/v1
AGENT_MODEL=gpt-6-luna
FAST_MODEL=gpt-6-luna
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
BOXAPI_TOOLS=1
# API_WORKERS=3
# AGENT_WORKERS=2
# --- backups (S3-compatible object storage) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# BACKUP_KEEP=14
# --- make push-test only ---
# DEPLOY_HOST=user@vps
# DEPLOY_DIR=/srv/torobgard
