# torob-gard-api (Django + gunicorn). Liara sets PORT; the app listens on it (8000 when unset).
# From the Liara Postgres (PostGIS + pgvector) on the same network
DATABASE_URL=
# From the Liara Redis on the same network
REDIS_URL=
# Must be 0 in production
DEBUG=0
# Generate: a long random string. The agent needs the same value (it checks the login cookie)
DJANGO_SECRET_KEY=
# Hosts this app answers: its private name (web calls it) and the public liara.run domain
ALLOWED_HOSTS=torob-gard-api,.liara.run
# Admin over https from the public domains, comma-separated
CSRF_TRUSTED_ORIGINS=https://torob-gard-api.liara.run,https://torob-gard-web.liara.run
# Generate: random hex (HMAC key for phone numbers)
PHONE_PEPPER=
# Generate: base64 of 32 random bytes (AES key for phone numbers)
PHONE_KEY=
# SMS login (Kavenegar). Empty = no SMS: phone login does not work in production
KAVENEGAR_KEY=
KAVENEGAR_TEMPLATE=
# Embedding model of the stored vectors (search); must match the restored data
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
# GapGPT, for the api's embed command only
BOXAPI_KEY=
BOXAPI_BASE_URL=https://api.gapgpt.app/v1
# Proxies in front that append to X-Forwarded-For (Liara's ingress: 1)
TRUSTED_PROXY_HOPS=1
# gunicorn workers
API_WORKERS=3
