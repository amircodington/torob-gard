# torob-gard-web (Next standalone). Liara sets PORT; the app listens on it (3000 when unset).
# The api and the agent on the private network (read at run time; these are the defaults)
API_URL=http://torob-gard-api:8000
AGENT_URL=http://torob-gard-agent:8001
# Public URL of this site: canonical and OG links, sitemap
SITE_URL=https://torob-gard-web.liara.run
