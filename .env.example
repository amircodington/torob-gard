# Torob images host; prod sets /img (nginx proxy, R-P7)
NEXT_PUBLIC_IMG_BASE=https://image.torob.com
# phone login (P3 Task 4). PHONE_PEPPER: random hex (HMAC of the phone); PHONE_KEY: base64 of 32 random bytes (AES-GCM)
PHONE_PEPPER=
PHONE_KEY=
# Kavenegar verify/lookup; empty = dev sender (logs the code only, DEBUG only)
KAVENEGAR_KEY=
KAVENEGAR_TEMPLATE=
