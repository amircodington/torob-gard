# torob-gard-agent (FastAPI + uvicorn, SSE). Liara sets PORT; the app listens on it (8001 when unset).
# From the Liara Postgres (PostGIS + pgvector) on the same network
DATABASE_URL=
# From the Liara Redis on the same network
REDIS_URL=
# Same value as torob-gard-api's DJANGO_SECRET_KEY (verifies the login cookie)
DJANGO_SECRET_KEY=
# GapGPT key (OpenAI-compatible)
BOXAPI_KEY=
# Optional second key, used when the first runs out
BOXAPI_KEY_SECOND=
# GapGPT; https://api.gapapi.com/v1 is the same API through their CDN if this host is unreachable
BOXAPI_BASE_URL=https://api.gapgpt.app/v1
# Chat model and the cheap fast model
AGENT_MODEL=gpt-6-luna
FAST_MODEL=gpt-6-luna
# Must match the stored embeddings
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
# 1 = the model calls tools natively
BOXAPI_TOOLS=1
# Seconds before an LLM call gives up
LLM_TIMEOUT_S=15
# Proxies in front that append to X-Forwarded-For (Liara's ingress: 1)
TRUSTED_PROXY_HOPS=1
# uvicorn workers
AGENT_WORKERS=2
